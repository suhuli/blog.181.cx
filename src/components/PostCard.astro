---
interface Props {
  post: {
    data: {
      title: string;
      slug: string;
      description: string;
      publishedAt: Date;
      tags: string[];
      featured?: boolean;
    }
  };
  compact?: boolean;
}
const { post, compact = false } = Astro.props;
const date = post.data.publishedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---
<article class:list={['post-card', { compact }]}>
  <div class="post-meta">
    <time datetime={post.data.publishedAt.toISOString()}>{date}</time>
    {post.data.featured && <span class="featured">精选</span>}
  </div>
  <h2><a href={`/post/${post.data.slug}/`}>{post.data.title}</a></h2>
  {post.data.description && <p>{post.data.description}</p>}
  {post.data.tags.length > 0 && (
    <div class="tag-row" aria-label="文章标签">
      {post.data.tags.map(tag => <a href={`/tag/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
    </div>
  )}
  <a class="card-link" href={`/post/${post.data.slug}/`} aria-label={`阅读《${post.data.title}》`}>阅读文章 <span>→</span></a>
</article>
